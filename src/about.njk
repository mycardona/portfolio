---
layout: layouts/base.njk
title: About
permalink: /about/
---
{% set aboutHero = (about and about.hero) or {} %}
{% set aboutDetail = (about and about.detail) or {} %}
{% set aboutSections = aboutDetail.sections or [] %}
{% set aboutResume = (about and about.resume) or {} %}
{% set resumeContactUrl = aboutResume.contactUrl or '/book/' %}
{% set showResumePdf = aboutResume.display == 'pdf' and aboutResume.pdf %}
{% set hasHeroCard = aboutHero.title or aboutHero.lead %}

{% macro resumeSection(section) %}
  {% set items = section.items or [] %}
  {% if items.length %}
    <section class="resume-block">
      {% if section.heading %}
        <h3>{{ section.heading }}</h3>
      {% endif %}
      {% if section.type == 'credits' %}
        <ul class="resume-credits">
          {% for credit in items %}
            <li>
              {% if credit.role %}
                <p class="credit-role">{{ credit.role }}</p>
              {% endif %}
              {% if credit.showTitle or credit.director or credit.details %}
                <p class="credit-meta">
                  {% if credit.showTitle %}
                    <span class="show-title">"{{ credit.showTitle }}"</span>
                  {% endif %}
                  {% if credit.director %}
                    {% if credit.showTitle %} {% endif %}Dir: {{ credit.director }}
                  {% endif %}
                  {% if credit.details %}
                    <br>{{ credit.details }}
                  {% endif %}
                </p>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% elif section.type == 'works' %}
        <ul class="resume-credits resume-credits-dated">
          {% for item in items %}
            <li>
              {% if item.date %}
                <p class="credit-date">{{ item.date }}</p>
              {% endif %}
              <div>
                {% if item.role %}
                  <p class="credit-role">{{ item.role }}</p>
                {% endif %}
                {% if item.highlight or item.details %}
                  <p class="credit-meta">
                    {% if item.highlight %}
                      <span class="credit-highlight">{{ item.highlight }}</span>
                    {% endif %}
                    {% if item.details %}
                      {% if item.highlight %}<br>{% endif %}{{ item.details }}
                    {% endif %}
                  </p>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      {% elif section.type == 'simple' %}
        <ul class="resume-list resume-list-skill-columns">
          {% for item in items %}
            {% if item %}
              <li>{{ item }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      {% else %}
        <ul class="resume-list resume-list-dated">
          {% for item in items %}
            <li>
              {% if item.date %}
                <span class="list-date">{{ item.date }}</span>
              {% endif %}
              {% if item.text %}
                <span class="list-text">{{ item.text }}</span>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>
  {% endif %}
{% endmacro %}

{% if hasHeroCard %}
  <section class="about-hero">
    {% if aboutHero.eyebrow %}
      <p class="eyebrow">{{ aboutHero.eyebrow }}</p>
    {% endif %}
    {% if aboutHero.title %}
      <h1>{{ aboutHero.title }}</h1>
    {% endif %}
    {% if aboutHero.lead %}
      <p class="about-lead">{{ aboutHero.lead }}</p>
    {% endif %}
  </section>
{% elif aboutHero.eyebrow %}
  <p class="eyebrow about-eyebrow">{{ aboutHero.eyebrow }}</p>
{% endif %}

{% if aboutSections.length or aboutHero.headshot %}
  <section class="about-layout{% if aboutHero.headshot %} has-headshot{% endif %}" aria-label="About details">
    {% if aboutHero.headshot %}
      <figure class="about-headshot">
        {% optimizedImage aboutHero.headshot, aboutHero.headshotAlt or "", "(min-width: 56rem) 22rem, 100vw" %}
      </figure>
    {% endif %}
    <div class="about-panels">
      {% for section in aboutSections %}
        {% set sectionParagraphs = section.paragraphs or [] %}
        <article class="about-panel">
          {% if section.title %}
            <h2>{{ section.title }}</h2>
          {% endif %}
          {% for paragraph in sectionParagraphs %}
            {% if paragraph %}
              <p>{{ paragraph }}</p>
            {% endif %}
          {% endfor %}
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}

<section class="resume-inline" aria-label="Acting resume">
  <div class="resume-header">
    {% if aboutResume.eyebrow %}
      <p class="eyebrow">{{ aboutResume.eyebrow }}</p>
    {% endif %}
    {% if aboutResume.title %}
      <h2>{{ aboutResume.title }}</h2>
    {% endif %}
  </div>

  {% if showResumePdf %}
    {% set pdfUrl = aboutResume.pdf | assetUrl %}
    {% set pdfLabel = aboutResume.pdfLabel or 'Download PDF resume' %}
    <div class="resume-pdf">
      <object class="resume-pdf-frame" data="{{ pdfUrl }}#view=FitH" type="application/pdf" aria-label="{{ aboutResume.title or 'Resume' }} (PDF)">
        <p class="resume-pdf-fallback">
          This browser can't show the PDF here.
          <a href="{{ pdfUrl }}" target="_blank" rel="noopener">Open the resume PDF</a>.
        </p>
      </object>
      <p class="resume-pdf-actions">
        <a class="resume-pdf-link" href="{{ pdfUrl }}" target="_blank" rel="noopener" download>{{ pdfLabel }}</a>
      </p>
    </div>
  {% else %}
    <article class="resume-paper">
      <header class="resume-paper-head">
        <div class="resume-head-main">
          {% if aboutResume.name %}
            <p class="resume-name">{{ aboutResume.name }}</p>
          {% endif %}
          {% if aboutResume.tagline %}
            <p class="resume-tagline">{{ aboutResume.tagline }}</p>
          {% endif %}
        </div>
        <div class="resume-head-contact">
          {% if aboutResume.contactTitle %}
            <a class="resume-contact-title" href="{{ resumeContactUrl | assetUrl }}">{{ aboutResume.contactTitle }}</a>
          {% endif %}
          {% if aboutResume.contactNote %}
            <p class="resume-contact-note">{{ aboutResume.contactNote }}</p>
          {% endif %}
        </div>
      </header>

      <div class="resume-paper-body">
        <div class="resume-column resume-column-main">
          {% for section in (aboutResume.main and aboutResume.main.sections) or [] %}
            {{ resumeSection(section) }}
          {% endfor %}
        </div>

        <aside class="resume-column resume-column-side">
          {% for section in (aboutResume.side and aboutResume.side.sections) or [] %}
            {{ resumeSection(section) }}
          {% endfor %}
        </aside>
      </div>
    </article>
  {% endif %}
</section>
